{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "toolbar",
  "description": "The floating toolbar: shows/hides itself and opens its native options menu.",
  "windows": ["toolbar"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-content-protected",
    "core:menu:default"
  ]
}
